#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel)
if [ -x "$ROOT/venv/Scripts/python.exe" ]; then
    PYTHON="$ROOT/venv/Scripts/python.exe"
elif [ -x "$ROOT/venv/bin/python" ]; then
    PYTHON="$ROOT/venv/bin/python"
else
    PYTHON=python
fi

echo "[pre-push] running unit tests"
"$PYTHON" -m unittest discover -s tests

echo "[pre-push] running shadow readiness check"
"$PYTHON" "$ROOT/scripts/shadow_readiness_check.py"

echo "[pre-push] validating migration plan"
"$PYTHON" "$ROOT/scripts/apply_supabase_migrations.py"

echo "[pre-push] ok"
