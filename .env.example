SUPABASE_DB_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres"
ALTTEZ_DATA_SOURCE=auto
ALTTEZ_SUPABASE_VIEW=public.international_results_compat
ALTTEZ_ALLOW_LOCAL_FALLBACK=true
ALTTEZ_USE_SYSTEM_PROXY=false

# Provider stack priority for raw ingestion.
ALTTEZ_PROVIDER_STACK=espn,football_data_org,statsbomb_open,local_json

# Provider stack priority for daily live agenda.
# ESPN is the keyless primary; football_data_org is the structured fallback.
ALTTEZ_LIVE_PROVIDER_STACK=espn,football_data_org,local_json

# ESPN scoreboard (keyless primary live feed; covers fifa.world + fifa.friendly).
ALTTEZ_ESPN_ENABLED=true
ALTTEZ_ESPN_LEAGUES=fifa.world,fifa.friendly
ALTTEZ_ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer

# API-Football (RETIRED: key dead. Left for optional redundancy only.)
ALTTEZ_API_FOOTBALL_KEY=replace-me
ALTTEZ_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# football-data.org (secondary structured fallback).
ALTTEZ_FOOTBALL_DATA_KEY=replace-me
ALTTEZ_FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
ALTTEZ_FOOTBALL_DATA_LIVE_COMPETITIONS=WC,EC

# StatsBomb Open Data local mirror/clone root.
ALTTEZ_STATSBOMB_OPEN_ROOT=C:\path\to\statsbomb-open-data

# Local JSON fallback for manual/testing ingestion.
ALTTEZ_LOCAL_JSON_PATH=artifacts\provider-fallback.json

# Optional alert webhook for external notifications (Slack/Discord/Telegram/webhook endpoint).
ALTTEZ_ALERT_WEBHOOK_URL=
ALTTEZ_ALERT_WEBHOOK_TIMEOUT_SECONDS=8
ALTTEZ_ALERTS_TELEGRAM_ENABLED=false
ALTTEZ_ALERTS_TELEGRAM_BOT_TOKEN=
ALTTEZ_ALERTS_TELEGRAM_CHAT_ID=

# Optional daily decision brief delivery endpoint.
ALTTEZ_DAILY_BRIEF_WEBHOOK_URL=
ALTTEZ_DAILY_BRIEF_WEBHOOK_TIMEOUT_SECONDS=10
ALTTEZ_DAILY_BRIEF_DELIVER=false
ALTTEZ_DAILY_BRIEF_DELIVERY_CHANNEL=telegram
ALTTEZ_DAILY_BRIEF_TELEGRAM_BOT_TOKEN=
ALTTEZ_DAILY_BRIEF_TELEGRAM_CHAT_ID=
ALTTEZ_DAILY_BRIEF_DELIVERY_TIMEOUT_SECONDS=10
ALTTEZ_AUTO_PROMOTE_MODELS=false
ALTTEZ_SUPPORTED_PRODUCTION_MODEL_FAMILIES=poisson,xgboost
ALTTEZ_EXPANSION_LOOKBACK_YEARS=4
ALTTEZ_EXPANSION_MIN_MATCHES=60
ALTTEZ_EXPANSION_MIN_TEAMS=10
ALTTEZ_EXPANSION_MIN_EVALUATED=20
ALTTEZ_EXPANSION_MIN_ANALYZABLE_RATE=0.55
ALTTEZ_EXPANSION_MAX_BRIER=0.66
